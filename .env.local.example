# Supabase — required for admin inventory management
NEXT_PUBLIC_SITE_URL=https://www.skltrucks.com
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Email — Gmail app password stays in .env.local, never in this example
EMAIL_USER=staff@example.com
EMAIL_PASSWORD=your-gmail-app-password
RECIPIENT_EMAIL=inbox@example.com

# Optional — internet search pilot (server-only). Leave unset until a real key exists.
# TAVILY_API_KEY=
# OPENAI_API_KEY=
# SOURCING_SEARCH_PROVIDER=tavily
# OPENAI_SEARCH_MODEL=gpt-4o-mini
# OPENAI_SEARCH_MAX_TOOL_CALLS=6
# SOURCING_STAFF_EMAILS=

# Optional — Google Routes driving distance for market comparison
# GOOGLE_MAPS_ROUTES_API_KEY=
